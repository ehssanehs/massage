#!/usr/bin/env php
<?php
require __DIR__ . '/../app/bootstrap.php';
use App\Core\DB; use App\Services\FollowUpService; use App\Services\BackupService; use App\Services\RestoreCheckService; use App\Support\Tenant;

$args = array_slice($argv, 1);
$cmd = array_shift($args) ?? 'help';
$positional = array_values(array_filter($args, static fn(string $a): bool => !str_starts_with($a, '--')));

/**
 * Which sections a DB command applies to. Defaults to every section that has a
 * database configured, so `migrate` keeps both CRMs in step. `--tenant=men`
 * (or women) narrows it to one; a plain DB_DATABASE install yields one pass.
 */
function target_tenants(): array {
    $requested = null;
    foreach ($GLOBALS['args'] as $a) {
        if (preg_match('/^--tenant=(.+)$/', $a, $m)) $requested = $m[1];
    }
    $all = array_keys(Tenant::all());
    $configured = array_values(array_filter($all, function (string $t): bool {
        $name = env_value('DB_DATABASE_' . strtoupper($t));
        return is_string($name) && trim($name) !== '';
    }));
    if ($configured === []) {
        // Legacy single-install config, or an explicit scratch DB for tests.
        if (is_string(env_value('DB_DATABASE')) && trim((string)env_value('DB_DATABASE')) !== '') return [null];
        throw new RuntimeException('هیچ پایگاه‌داده‌ای تعیین نشده است؛ DB_DATABASE_MEN و DB_DATABASE_WOMEN را در .env مقداردهی کنید.');
    }
    if ($requested === null) return $configured;
    if ($requested === 'all') return $configured;
    if (!in_array($requested, $all, true)) throw new InvalidArgumentException("بخش نامعتبر: $requested (men|women|all)");
    if (!in_array($requested, $configured, true)) throw new RuntimeException('برای بخش ' . Tenant::all()[$requested]['label'] . ' پایگاه‌داده‌ای تنظیم نشده است.');
    return [$requested];
}

/**
 * The public site owns its own database (SITE_DATABASE) when it is configured,
 * so its migrations and content seeders must run there too — not only in the
 * section CRMs. Unset SITE_DATABASE means "same database", nothing extra runs.
 */
function site_pdo(): ?PDO {
    $name = trim((string)env_value('SITE_DATABASE', ''));
    if ($name === '') return null;
    $dsn = 'mysql:host=' . env_value('DB_HOST', '127.0.0.1') . ';port=' . env_value('DB_PORT', '3306')
        . ';dbname=' . $name . ';charset=utf8mb4';
    return new PDO($dsn, env_value('DB_USERNAME', 'root'), env_value('DB_PASSWORD', ''),
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
}
function run_site_migrations(): void {
    $pdo = site_pdo();
    if ($pdo === null) return;
    $files = glob(base_path('database/migrations/*.sql')) ?: [];
    sort($files);
    foreach ($files as $file) $pdo->exec(file_get_contents($file));
}
function seed_site(): void {
    $pdo = site_pdo();
    if ($pdo === null) return;
    $pdo->exec(file_get_contents(base_path('database/seeders/003_site_content.sql')));
}

/**
 * Site content only (copy + the massage catalog). Safe to re-run on a live
 * install: 003 uses INSERT IGNORE, so it never overwrites edits the owner made.
 * This exists because `seed` also re-applies 001, which resets the admin
 * password and the settings to their defaults — not something an update wants.
 */
function seed_site_all(): void {
    $file = base_path('database/seeders/003_site_content.sql');
    each_tenant(function () use ($file): void { DB::pdo()->exec(file_get_contents($file)); });
    seed_site();
}

/**
 * Where the public site reads its content from, and whether it is actually there.
 * Run this first when the site looks empty or out of date after an update.
 */
function site_health(): void {
    echo "Site content database: " . \App\Support\SiteContent::database() . "\n";
    try {
        $blocks = (int)\App\Support\SiteContent::pdo()->query('SELECT COUNT(*) FROM site_blocks')->fetchColumn();
        $types = (int)\App\Support\SiteContent::pdo()->query('SELECT COUNT(*) FROM massage_types WHERE deleted_at IS NULL')->fetchColumn();
        $withImage = (int)\App\Support\SiteContent::pdo()->query("SELECT COUNT(*) FROM massage_types WHERE image IS NOT NULL AND image <> ''")->fetchColumn();
        echo "  site_blocks:    $blocks\n";
        echo "  massage_types:  $types ($withImage with an image)\n";
        if ($blocks === 0) echo "  ! no copy found: run `php bin/console site:seed`\n";
    } catch (\Throwable $e) {
        echo "  ! " . $e->getMessage() . "\n";
        echo "  run `php bin/console migrate` first.\n";
    }
    echo "  photos:         " . count(glob(base_path('public/assets/img/massage/photos/*.jpg')) ?: []) . " bundled\n";
    $uploads = glob(base_path('public/uploads/site/*')) ?: [];
    echo "  uploads:        " . count($uploads) . " file(s) in public/uploads/site\n";
}

function run_migrations(): void {
    $files = glob(base_path('database/migrations/*.sql')) ?: [];
    sort($files);
    foreach ($files as $file) DB::pdo()->exec(file_get_contents($file));
}
function seed(): void {
    DB::pdo()->exec(file_get_contents(base_path('database/seeders/001_seed_defaults.sql')));
    // Public site copy and the massage catalog. Not demo CRM data: every
    // customer/session/expense table stays empty after a fresh install.
    DB::pdo()->exec(file_get_contents(base_path('database/seeders/003_site_content.sql')));
}
/**
 * Optional sample data (a demo branch, services, therapists, customers, ...).
 * Never part of install: a fresh install must contain no demo records.
 */
function seed_demo(): void {
    DB::pdo()->exec(file_get_contents(base_path('database/seeders/002_demo_data.sql')));
}
/** Run $fn once per target section, switching the connection between passes. */
function each_tenant(callable $fn): void {
    foreach (target_tenants() as $tenant) {
        if ($tenant !== null) Tenant::activateForCli($tenant);
        DB::reset();
        $label = $tenant === null ? 'تک‌بخشی' : Tenant::all()[$tenant]['label'] . " ($tenant)";
        echo "— $label\n";
        $fn($tenant);
    }
}

try {
    if ($cmd === 'migrate') {
        each_tenant(function (): void { run_migrations(); echo "  Migrations completed.\n"; });
        run_site_migrations();
    } elseif ($cmd === 'seed') {
        each_tenant(function (): void { seed(); echo "  Seeders completed.\n"; });
        seed_site();
    } elseif ($cmd === 'install') {
        each_tenant(function (): void { run_migrations(); seed(); echo "  Installed (no demo data). Default admin: admin@example.com / password\n"; });
        run_site_migrations(); seed_site();
    } elseif ($cmd === 'site:check') {
        site_health();
    } elseif ($cmd === 'site:seed') {
        seed_site_all();
        echo "  Site content ensured (copy + massage catalog; existing edits kept).\n";
    } elseif ($cmd === 'demo:seed') {
        each_tenant(function (): void { seed_demo(); echo "  Sample data loaded (demo services, therapists, customers, ...).\n"; });
    } elseif ($cmd === 'user:password') {
        $email = $positional[0] ?? 'admin@example.com';
        $plain = $positional[1] ?? 'password';
        $hash = password_hash($plain, PASSWORD_DEFAULT);
        $updated = 0;
        each_tenant(function () use ($email, $hash, &$updated): void {
            $n = DB::exec("UPDATE users SET password_hash=?, status='active', updated_at=NOW() WHERE email=?", [$hash, $email]);
            if ($n === 0) { echo "  No user found with email $email\n"; return; }
            $updated += $n;
            echo "  Password updated for $email\n";
        });
        if ($updated === 0) { fwrite(STDERR, "No user found with email $email in any section\n"); exit(1); }
    } elseif ($cmd === 'schedule:run') {
        each_tenant(function (): void {
            $n = FollowUpService::generateDueFromLastSessions();
            $low = DB::select('SELECT * FROM inventory_items WHERE quantity <= minimum_quantity AND status="active"');
            echo "  Follow-ups generated: $n; Low stock items: " . count($low) . "\n";
        });
    } elseif ($cmd === 'backup:check') {
        if (count($positional) > 0) throw new InvalidArgumentException('این دستور فایل SQL را وارد یا بررسی نمی‌کند؛ آن را بدون آرگومان روی دیتابیس آزمایشیِ بازیابی‌شده اجرا کنید.');
        $fail = false;
        each_tenant(function () use (&$fail): void {
            $report = RestoreCheckService::inspect();
            echo RestoreCheckService::formatReport($report);
            if (!$report['ok']) $fail = true;
        });
        exit($fail ? 2 : 0);
    } elseif ($cmd === 'backup:create') {
        each_tenant(function (): void { echo '  ' . BackupService::create() . "\n"; });
    } else {
        echo "Commands: install, migrate, seed, site:seed, site:check, demo:seed, user:password [email] [password], schedule:run, backup:create, backup:check\n";
        echo "Options:  --tenant=men|women|all (default: every configured section)\n";
    }
} catch (Throwable $e) { fwrite(STDERR, $e->getMessage() . "\n"); exit(1); }
