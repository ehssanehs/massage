APP_NAME="مرکز ماساژ آرامش"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tehran

DB_HOST=127.0.0.1
DB_PORT=3306

# Two completely separate CRMs, one per section. Each section gets its own
# database, its own staff accounts and its own admins; nothing is shared.
# Defining either variable switches the app into two-section mode: the login
# form then asks for the section and /men and /women become entry points.
DB_DATABASE_MEN=massage_men
DB_DATABASE_WOMEN=massage_women

# پایگاه‌دادهٔ محتوای سایت عمومی (متن‌ها و کاتالوگ ماساژها). اختیاری است:
# اگر خالی بماند از DB_DATABASE و در نصب دوبخشی از DB_DATABASE_MEN استفاده می‌شود.
# SITE_DATABASE=massage_site

# ---------------------------------------------------------------------------
# درگاه پرداخت (کارت هدیه). تا وقتی ZARINPAL_MERCHANT_ID خالی است، فرم خرید
# کارت هدیه در سایت نمایش داده نمی‌شود و هیچ پرداخت موفقی شبیه‌سازی نمی‌شود.
# ---------------------------------------------------------------------------
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
# برای تست روی محیط زرین‌پال: true
ZARINPAL_SANDBOX=false
# واحد مبلغ ارسالی به زرین‌پال: IRR (ریال) یا IRT (تومان)
ZARINPAL_CURRENCY=IRR
# آدرس بازگشت از درگاه. خالی بماند تا خودکار از دامنهٔ درخواست ساخته شود.
PAYMENT_CALLBACK_URL=

# Single-section install: used only when neither variable above is set
# (kept for existing installs and for the test suites' scratch databases).
# DB_DATABASE=massage_crm

DB_USERNAME=root
DB_PASSWORD=

SESSION_SECURE=false
# Backups hold every customer record and password hash, so keep them OUTSIDE the
# web root. An absolute path is also accepted (e.g. /var/backups/massage).
BACKUP_PATH=storage/backups
UPLOAD_PATH=public/uploads
