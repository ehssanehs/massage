.env
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.gitkeep
!public/uploads/site/
public/uploads/site/*
!public/uploads/site/.gitkeep
public/storage/backups/*
!public/storage/backups/.gitkeep
*.log
.DS_Store
# Optional browser-test dependencies
node_modules/
# Local session files (fallback session storage)
storage/sessions/*
!storage/sessions/.gitkeep
# Backups are data, never source
storage/backups/*
!storage/backups/.gitkeep
